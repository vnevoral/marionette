{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Marionette: build UI",
			"type": "shell",
			"command": "npm run build",
			"options": {
				"cwd": "${workspaceFolder}/web"
			},
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": []
		},
		{
			"label": "Marionette: dev config",
			"type": "shell",
			"command": "make dev-config",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Marionette: prepare backend",
			"dependsOn": [
				"Marionette: build UI",
				"Marionette: dev config"
			],
			"dependsOrder": "sequence",
			"problemMatcher": []
		}
	]
}
