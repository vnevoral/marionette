{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Marionette: backend",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/cmd/marionette",
			"preLaunchTask": "Marionette: prepare backend",
			"env": {
				"MARIONETTE_ADDR": ":8080",
				"MARIONETTE_CONFIG": "${workspaceFolder}/.dev/marionette.json",
				"MARIONETTE_CONTROL_SOCKET": "${workspaceFolder}/.dev/marionette.sock"
			},
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": "marionette listening.* addr=\\S*:([0-9]+)",
				"uriFormat": "http://localhost:%s"
			}
		},
		{
			"name": "Marionette: frontend (Vite)",
			"type": "node-terminal",
			"request": "launch",
			"command": "npm run dev -- --host 0.0.0.0",
			"cwd": "${workspaceFolder}/web",
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": "Local:\\s+(http://localhost:5173/)",
				"uriFormat": "%s"
			}
		}
	]
}
