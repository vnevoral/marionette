{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Marionette: backend",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/cmd/marionette",
			"preLaunchTask": "Marionette: build UI",
			"env": {
				"MARIONETTE_ADDR": ":8080",
				"MARIONETTE_CONFIG": "${workspaceFolder}/marionette.json"
			},
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": "marionette listening on :([0-9]+)",
				"uriFormat": "http://localhost:%s"
			}
		}
	]
}
