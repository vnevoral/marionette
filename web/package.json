{
	"name": "marionette-ui",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"lint": "eslint . --max-warnings 0",
		"lint:types": "vue-tsc --noEmit -p tsconfig.app.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@lucide/vue": "^1.52.0",
		"@primeuix/themes": "^2.0.3",
		"primeicons": "^7.0.0",
		"primevue": "^4.5.5",
		"vue": "^3.5.44",
		"vue-router": "^5.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.5",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vitest/coverage-v8": "^5.0.5",
		"@vue/test-utils": "^2.5.1",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.11.1",
		"globals": "^17.13.0",
		"happy-dom": "^20.14.6",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"vue-tsc": "^3.3.13"
	}
}
