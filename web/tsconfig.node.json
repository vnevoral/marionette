{
	"compilerOptions": {
		"composite": true,
		"target": "ES2022",
		"lib": ["ES2023", "DOM"],
		"skipLibCheck": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["node"],
		"noEmit": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"strict": true,
		"allowImportingTsExtensions": true
	},
	"include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
