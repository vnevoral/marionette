# Marionette service configuration.
MARIONETTE_CONFIG=/var/lib/marionette/marionette.json
MARIONETTE_ADDR=:8080
# Total budget for a graceful stop (Go duration). Must stay below the unit's
# TimeoutStopSec (systemd default 90s); the default is 20s.
#MARIONETTE_SHUTDOWN_TIMEOUT=20s
# Optional allowlist of Host values (host:port, comma-separated) accepted by
# mutating API requests. Empty accepts any host.
#MARIONETTE_ALLOWED_HOSTS=pi.local:8080,192.168.1.10:8080
# Access control: only paired devices can use the UI and API (on|off).
# Get a pairing code for a new device with `sudo marionette pair`; with no
# device paired yet, the code is also in `journalctl -u marionette`.
#MARIONETTE_AUTH=on
# Days a device may stay unused before it must pair again (1-400).
#MARIONETTE_DEVICE_EXPIRY_DAYS=60
# Secure attribute of the device cookie: auto (TLS connection), always
# (behind a TLS reverse proxy) or never.
#MARIONETTE_COOKIE_SECURE=auto
# Paired devices file; defaults to devices.json next to MARIONETTE_CONFIG.
#MARIONETTE_DEVICES=/var/lib/marionette/devices.json
# Control socket of `marionette pair`. The command does not read this file:
# after changing the path run `sudo MARIONETTE_CONTROL_SOCKET=<path> marionette pair`.
#MARIONETTE_CONTROL_SOCKET=/run/marionette/control.sock
# Log format (text|json) and minimum level (debug|info|warn|error).
#MARIONETTE_LOG_FORMAT=text
#MARIONETTE_LOG_LEVEL=info
