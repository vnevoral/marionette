[Unit]
Description=Marionette action card service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=marionette
Group=marionette
WorkingDirectory=/var/lib/marionette
EnvironmentFile=-/etc/default/marionette
ExecStart=/usr/local/bin/marionette
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/marionette
# /run/marionette holds the control socket of `marionette pair` (ADR-0013);
# only root and the service user can enter it.
RuntimeDirectory=marionette
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
