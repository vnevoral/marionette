# Go
/bin/
/tmp/
*.exe
# Delve debug binaries written next to the package by VS Code
__debug_bin*

# Local dev data: configuration (created from deploy/dev-fixture.json by
# `make dev-config`), paired devices and the control socket
/.dev/

# Embedded UI build output (generated by `make ui-build`); .gitkeep keeps the
# directory so go:embed compiles without a UI build (internal/webui).
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Node / UI
web/node_modules/
web/dist/
web/coverage/
web/test-results/
web/playwright-report/
web/e2e/.auth/

# Personal Claude Code settings
/.claude/settings.local.json

# Editor / OS
.DS_Store
*.log
